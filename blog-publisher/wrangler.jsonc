{
  "name": "shift-blog-publisher",
  "main": "worker.mjs",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": [
    "nodejs_compat",
    "global_fetch_strictly_public"
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "DAILY_CONTENT_BUDGET_VERIFIED": "true",
    "DAILY_CONTENT_GATEWAY": "shift-ai",
    "SHIFT_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "BLOG_CONTRIBUTOR_ENABLED": "true",
    "BLOG_MEDIA_UPLOAD_ENABLED": "true",
    "BLOG_ACCESS_ACCEPTED": "true",
    "DAILY_WEBSITE_CONTENT_ENABLED": "false",
    "DAILY_WEBSITE_EDITORIAL_AUTOPUBLISH": "false",
    "APPROVED_REFRESHES_ENABLED": "true"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shift-core",
      "database_id": "88f40aed-cb23-4372-8c94-8a73f48bc847"
    }
  ],
  "r2_buckets": [
    {
      "binding": "BLOG_MEDIA",
      "bucket_name": "shift-blog-media"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "services": [
    {
      "binding": "CORE",
      "service": "shift-core"
    },
    {
      "binding": "KNOWLEDGE",
      "service": "shift-knowledge-presentation-20261022"
    },
    {
      "binding": "OBESITY",
      "service": "shift-obesity-presentation-20261022"
    },
    {
      "binding": "HEALTH",
      "service": "shift-health-presentation-20261021"
    }
  ],
  "triggers": {
    "crons": [
      "*/15 * * * *"
    ]
  }
}
