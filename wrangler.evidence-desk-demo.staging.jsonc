{
  "name": "shift-evidence-desk-r1x-demo",
  "main": "evidence-desk-demo-entry.js",
  "compatibility_date": "2026-08-26",
  "workers_dev": true,
  "preview_urls": true,
  "assets": {
    "directory": ".evidence-desk-demo-dist",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "vars": {
    "EVIDENCE_DESK_ENV": "non-production-staging",
    "PUBLICATION_ENABLED": "false",
    "MODEL_ENABLED": "false",
    "LIVE_POLLING_ENABLED": "false"
  },
  "observability": { "enabled": true }
}
