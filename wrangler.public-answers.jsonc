{
  "name": "shift-public-answers",
  "main": "public-answers-entry.mjs",
  "compatibility_date": "2026-08-09",
  "workers_dev": true,
  "services": [
    {
      "binding": "CORE",
      "service": "shift-core"
    }
  ],
  "routes": [
