{
  "name": "shift-hq-management",
  "main": "hq-management-entry.mjs",
  "compatibility_date": "2026-09-11",
  "workers_dev": false,
  "routes": [
    {
      "pattern": "api.shiftsometimber.co.uk/v1/hq/management/*",
      "zone_name": "shiftsometimber.co.uk"
    },
    {
      "pattern": "api.shiftsometimber.co.uk/v1/hq/clinical*",
      "zone_name": "shiftsometimber.co.uk"
    }
  ],
  "vars": {
    "ALLOWED_ORIGINS": "https://hq.shiftsometimber.co.uk",
    "MEMBER_GP_DIRECTORY_V2_ENABLED": "true",
    "CLINICAL_CONTEXT_ENABLED": "false",
    "CLINICAL_CASEWORK_ENABLED": "false",
    "CLINICAL_REVIEW_READY": "false"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shift-core-db",
      "database_id": "88f40aed-cb23-4372-8c94-8a73f48bc847"
    }
  ],
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  },
  "r2_buckets": [
    {
      "binding": "CLINICAL_PRIVATE_FILES",
      "bucket_name": "shift-clinical-member-records"
    }
  ]
}
