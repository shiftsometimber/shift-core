    {"pattern": "shiftsometimber.co.uk/tap-room-v1.css*","zone_name": "shiftsometimber.co.uk"},
    {"pattern": "www.shiftsometimber.co.uk/tap-room-v1.css*","zone_name": "shiftsometimber.co.uk"},
    {"pattern": "shiftsometimber.co.uk/shift-push-sw-v1.js*","zone_name": "shiftsometimber.co.uk"},
    {"pattern": "www.shiftsometimber.co.uk/shift-push-sw-v1.js*","zone_name": "shiftsometimber.co.uk"},
