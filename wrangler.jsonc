{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "shift-core",
  "main": "shift-ai.js",
  "compatibility_date": "2026-08-09",

  "workers_dev": true,
  "preview_urls": false,

  "routes": [
    {
      "pattern": "api.shiftsometimber.co.uk",
      "custom_domain": true
    }
  ],

  "vars": {
    "AUTO_VERIFY_EMAIL": "true",
    "ALLOWED_ORIGINS": "https://shiftsometimber.co.uk,https://www.shiftsometimber.co.uk,https://shiftsometimber.com,https://www.shiftsometimber.com",
    "SHIFT_AI_MODEL": "@cf/meta/llama-3.1-8b-instruct-fast"
  },

  "ai": {
    "binding": "AI"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shift-core-db",
      "database_id": "88f40aed-cb23-4372-8c94-8a73f48bc847"
    }
  ],

  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true
    }
  }
}
