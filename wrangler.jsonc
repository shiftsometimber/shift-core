{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Shift Me live 3D build proof route enabled.
  "name": "shift-core",
  "main": "worker-entry-v6.js",
  "compatibility_date": "2026-08-09",

  "workers_dev": true,
  "preview_urls": false,

  "routes": [
    {"pattern": "api.shiftsometimber.co.uk","custom_domain": true},
    {"pattern": "shiftsometimber.co.uk/v1/*","zone_name": "shiftsometimber.co.uk"},
    {"pattern": "www.shiftsometimber.co.uk/v1/*","zone_name": "shiftsometimber.co.uk"},
    {"pattern": "shiftsometimber.co.uk/member/dashboard*","zone_name": "shiftsometimber.co.uk"},
    {"pattern": "www.shiftsometimber.co.uk/member/dashboard*","zone_name": "shiftsometimber.co.uk"},
    {"pattern": "shiftsometimber.co.uk/member-login*","zone_name": "shiftsometimber.co.uk"},
    {"pattern": "www.shiftsometimber.co.uk/member-login*","zone_name": "shiftsometimber.co.uk"},
    {"pattern": "shiftsometimber.co.uk/member-register*","zone_name": "shiftsometimber.co.uk"},
    {"pattern": "www.shiftsometimber.co.uk/member-register*","zone_name": "shiftsometimber.co.uk"},
    {"pattern": "shiftsometimber.co.uk/shift-me-3d-proof*","zone_name": "shiftsometimber.co.uk"},
    {"pattern": "www.shiftsometimber.co.uk/shift-me-3d-proof*","zone_name": "shiftsometimber.co.uk"},
    {"pattern": "shiftsometimber.co.uk/shift-me*","zone_name": "shiftsometimber.co.uk"},
    {"pattern": "www.shiftsometimber.co.uk/shift-me*","zone_name": "shiftsometimber.co.uk"},
