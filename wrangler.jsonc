    {"pattern": "www.shiftsometimber.co.uk/member-my-journey-v1.js*","zone_name": "shiftsometimber.co.uk"},
    {"pattern": "shiftsometimber.co.uk/member-my-journey-v1.css*","zone_name": "shiftsometimber.co.uk"},
    {"pattern": "www.shiftsometimber.co.uk/member-my-journey-v1.css*","zone_name": "shiftsometimber.co.uk"},
    {"pattern": "shiftsometimber.co.uk/member-medicines-watch-v1.js*","zone_name": "shiftsometimber.co.uk"},
    {"pattern": "www.shiftsometimber.co.uk/member-medicines-watch-v1.js*","zone_name": "shiftsometimber.co.uk"},
    {"pattern": "shiftsometimber.co.uk/member-medicines-watch-v1.css*","zone_name": "shiftsometimber.co.uk"},
    {"pattern": "www.shiftsometimber.co.uk/member-medicines-watch-v1.css*","zone_name": "shiftsometimber.co.uk"},
    {"pattern": "shiftsometimber.co.uk/member-sport-v1.js*","zone_name": "shiftsometimber.co.uk"},
    {"pattern": "www.shiftsometimber.co.uk/member-sport-v1.js*","zone_name": "shiftsometimber.co.uk"},
    {"pattern": "shiftsometimber.co.uk/member-sport-v1.css*","zone_name": "shiftsometimber.co.uk"},
    {"pattern": "www.shiftsometimber.co.uk/member-sport-v1.css*","zone_name": "shiftsometimber.co.uk"},
    {"pattern": "shiftsometimber.co.uk/member-p0-v1.css*","zone_name": "shiftsometimber.co.uk"},
    {"pattern": "www.shiftsometimber.co.uk/member-p0-v1.css*","zone_name": "shiftsometimber.co.uk"},
    {"pattern": "shiftsometimber.co.uk/assets/fit/premium/*","zone_name": "shiftsometimber.co.uk"},
    {"pattern": "www.shiftsometimber.co.uk/assets/fit/premium/*","zone_name": "shiftsometimber.co.uk"}
  ],

  "assets": {"directory": "./frontend/member","binding": "MEMBER_ASSETS","run_worker_first": true},
  "triggers": {"crons": ["0 * * * *"]},
  "vars": {
    "AUTO_VERIFY_EMAIL": "false",
    "ALLOWED_ORIGINS": "https://shiftsometimber.co.uk,https://www.shiftsometimber.co.uk,https://shiftsometimber.com,https://www.shiftsometimber.com,https://hq.shiftsometimber.co.uk,https://v23.projectshift.pages.dev,https://23v.projectshift.pages.dev",
    "SHIFT_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "PUBLIC_SITE_URL": "https://shiftsometimber.co.uk",
    "AUTH_EMAIL_FROM": "welcome@shiftsometimber.co.uk",
    "ORDER_NOTIFICATION_EMAIL": "orders@shiftsometimber.co.uk",
    "TAP_ROOM_MODERATION_OWNER": "Matt O'Brien",
    "TAP_ROOM_MODERATION_BACKUP": "Linda O'Brien",
    "TAP_ROOM_P0_EMAIL": "hello@shiftsometimber.co.uk",
    "STRIPE_MODE": "test"
  },
  "ai": {"binding": "AI"},
  "send_email": [{"name": "EMAIL"}],
  "d1_databases": [{"binding": "DB","database_name": "shift-core-db","database_id": "88f40aed-cb23-4372-8c94-8a73f48bc847"}],
  "observability": {"enabled": true,"logs": {"enabled": true}}
}
