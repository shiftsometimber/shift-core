{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Shift Me live 3D build proof route enabled.
  "name": "shift-core",
  "main": "shift-coach/worker.mjs",
  "compatibility_date": "2026-08-09",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],

  "workers_dev": true,
  "preview_urls": false,

  "routes": [
    {
      "pattern": "shiftsometimber.co.uk/*",
      "zone_name": "shiftsometimber.co.uk",
    },
    {
      "pattern": "www.shiftsometimber.co.uk/*",
      "zone_name": "shiftsometimber.co.uk",
    },
    { "pattern": "api.shiftsometimber.co.uk", "custom_domain": true },
    ],

  "assets": {
    "directory": "./frontend/member",
    "binding": "MEMBER_ASSETS",
    "run_worker_first": true,
  },
  "triggers": { "crons": ["*/15 * * * *"] },
  "vars": {
    "DAILY_WEBSITE_CONTENT_ENABLED": "true",
    "DAILY_WEBSITE_EDITORIAL_AUTOPUBLISH": "true",
    "DAILY_EDITORIAL_MODEL": "@cf/openai/gpt-oss-120b",
    "DAILY_EDITORIAL_SUPPORT_MODEL": "@cf/zai-org/glm-5.3",
    "DAILY_CONTENT_GATEWAY": "shift-ai",
    "DAILY_CONTENT_BUDGET_VERIFIED": "true",
    "DAILY_EDITORIAL_NOTIFY_ENABLED": "false",
    "DAILY_EDITORIAL_NOTIFY_TEMPLATE": "verified-link-v1",

    "MY_TIMBER_PWA_ENABLED": "true",
    "MEMBER_GP_LOOKUP_ENABLED": "true",
    "MEMBER_GP_DIRECTORY_V2_ENABLED": "true",
    "BABYLOVE_WEBHOOK_TOKEN_SHA256": "ab300f37dbd07d803773ecd6a8bd8f8225d60fbfa67e897af124fa809f34f088",
    "MY_TREATMENT_ENABLED": "true",
    "MY_TIMBER_WEEK_VIEW_ENABLED": "true",
    "MEMBER_EXPERIENCE_V1_ENABLED": "true",
    "HEALTH_PASSPORT_V1_ENABLED": "true",
    "AUTO_VERIFY_EMAIL": "false",
    "MEMBER_SIGNUP_ALERTS_ENABLED": "true",
    "ALLOWED_ORIGINS": "https://shiftsometimber.co.uk,https://www.shiftsometimber.co.uk,https://shiftsometimber.com,https://www.shiftsometimber.com,https://hq.shiftsometimber.co.uk,https://v23.projectshift.pages.dev,https://23v.projectshift.pages.dev",
    "SHIFT_AI_PRACTICAL_CONTEXT": "true",
    "SHIFT_AI_CONVERSATION_MEMORY": "true",
    "SHIFT_AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "PUBLIC_SITE_URL": "https://shiftsometimber.co.uk",
    "AUTH_EMAIL_FROM": "hello@shiftsometimber.co.uk",
    "ADMIN_EMAIL_FROM": "hq@shiftsometimber.co.uk",
    "ADMIN_NOTIFICATION_EMAIL": "hq@shiftsometimber.co.uk",
    "ORDER_NOTIFICATION_EMAIL": "orders@shiftsometimber.co.uk",
    "RADAR_ALERT_TO": "hq@shiftsometimber.co.uk",
    "RADAR_NOTIFICATION_MODE": "publication_only",
    "RADAR_PUBLICATION_EMAIL_TO": "matt@shiftsometimber.co.uk",
    "RADAR_PUBLICATION_EMAIL_SINCE": "2026-09-17T10:32:14Z",
    "EVIDENCE_DESK_ALERT_TO": "hq@shiftsometimber.co.uk",
    "EVIDENCE_DESK_READ_ENV": "non-production",
    "TAP_ROOM_MODERATION_OWNER": "Matt O'Brien",
    "TAP_ROOM_MODERATION_BACKUP": "Linda O'Brien",
    "TAP_ROOM_P0_EMAIL": "hq@shiftsometimber.co.uk",
    "STRIPE_MODE": "test",
  },
  "ai": { "binding": "AI" },
  "send_email": [{ "name": "EMAIL" }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shift-core-db",
      "database_id": "88f40aed-cb23-4372-8c94-8a73f48bc847",
    },
    {
      "binding": "EVIDENCE_DESK_READ_DB",
      "database_name": "shift-evidence-desk-r12-nonprod-db",
      "database_id": "8cbbd1f2-86bb-47a3-9b1a-e4735c3252c3",
    },
  ],
  "durable_objects": {
    "bindings": [
      { "name": "SITE_CONTENT_STATE", "class_name": "SiteContentState" },
    ],
  },
  "migrations": [
    {
      "tag": "v1-site-content-state",
      "new_sqlite_classes": ["SiteContentState"],
    },
  ],
  "observability": { "enabled": true, "logs": { "enabled": true } },
}
