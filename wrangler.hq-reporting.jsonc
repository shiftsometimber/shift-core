{
  "name": "shift-hq-reporting",
  "main": "hq-reporting-entry.mjs",
  "compatibility_date": "2026-09-11",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "api.shiftsometimber.co.uk/v1/hq/management/report*",
      "zone_name": "shiftsometimber.co.uk"
    },
    {
      "pattern": "api.shiftsometimber.co.uk/v1/hq/management/export*",
      "zone_name": "shiftsometimber.co.uk"
    }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "shift-core-db",
      "database_id": "88f40aed-cb23-4372-8c94-8a73f48bc847"
    }
  ],
  "services": [{"binding":"CORE","service":"shift-core"}],
  "observability": {
    "enabled": false
  }
}